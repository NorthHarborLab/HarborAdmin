{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls":"http://0.0.0.0:50001",
  "Harbor": {
    "AdminAuth": {
      "CaptchaEnabled": true,
      "Captcha": {
        "Type": "Point",
        "ChallengeMinutes": 2,
        "ImagePoolPath": "Application/Captcha/Assets/captcha",
        "PointMinChars": 2,
        "PointMaxChars": 3,
        "PointTolerance": 35,
        "PointCharPoolText": "港湾海洋帆船灯塔桥城山水云风雨星月日树花鸟石沙波潮岸岛旗路",
        "SliderMinSeconds": 0.3,
        "SliderMaxSeconds": 30,
        "RotateImageSize": 260,
        "RotateMinDegree": 120,
        "RotateMaxDegree": 300,
        "RotateDiffDegree": 20,
        "TranslateCanvasWidth": 420,
        "TranslateCanvasHeight": 280,
        "TranslateSquareLength": 42,
        "TranslateCircleRadius": 10,
        "TranslateDiffDistance": 3
      },
      "AllowDisableCaptchaInDevelopment": false,
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 7,
      "SigningKey": "HarborAdmin-Development-Signing-Key-Change-Me"
    },
    "AI": {
      "WorkerBaseUrl": "http://localhost:50002",
      "ProducerKey": "harbor-admin",
      "SigningSecret": "harbor-admin-dev-ai-signing-secret",
      "RequestTimeoutSeconds": 120,
      "StreamingTimeoutSeconds": 300
    },
    "Cap": {
      "Transport": "RabbitMq",
      "DefaultGroup": "harbor.admin.host",
      "Version": "v1",
      "UseDashboard": false,
      "Storage": {
        "Type": "InMemory",
        "ConnectionString": ""
      },
      "RabbitMq": {
        "HostName": "127.0.0.1",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "harbor.cap.default"
      },
      "RequestReply": {
        "Enabled": true,
        "ServiceName": "harbor-admin-host",
        "InstanceId": "local-host",
        "DefaultTimeoutSeconds": 120,
        "Transport": "Redis",
        "Store": "InMemory",
        "Redis": {
          "EndpointName": "harbor-admin-host",
          "ConnectionString": "localhost:6379",
          "StreamPrefix": "harbor:cap:reply"
        }
      }
    }
  }
}
