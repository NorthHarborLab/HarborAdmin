{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Harbor": {
    "YitterWorkId": 1,
    "ConfigCenter": {
      "Host": "127.0.0.1",
      "Port": 50000,
      "AppId": "harbor-admin",
      "Required": false
    },
    "DbConfig": {
      "Databases": [
        {
          "Key": "ConfigCenterDb",
          "DataType": "Sqlite",
          "ConnectionString": "Data Source=../HarborAdmin.ConfigCenter/configcenter.db",
          "SyncStructure": true,
          "ReadOnly": false,
          "SlaveList": []
        }
      ]
    },
    "Cap": {
      "Transport": "RabbitMq",
      "DefaultGroup": "harbor-admin",
      "Version": "v1",
      "FailedRetryCount": 5,
      "FailedRetryInterval": 15,
      "UseDashboard": true,
      "Storage": {
        "Type": "Sqlite",
        "ConnectionString": "Data Source=../data/cap.host.db"
      },
      "RabbitMq": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "harbor.cap.default"
      }
    },
    "Cache": {
      "Provider": "Redis",
      "KeyPrefix": "harbor",
      "DefaultExpirationSeconds": 600,
      "Redis": {
        "ConnectionString": "localhost:6379"
      },
      "Garnet": {
        "ConnectionString": "localhost:6379"
      }
    }
  }
}
